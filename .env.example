# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host:5432/gearup?sslmode=require

# Server
PORT=5000

# CORS allowed client origin
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google OAuth (optional - used for social login)
# Replace with your own values from https://console.cloud.google.com
#
# IMPORTANT: GOOGLE_REDIRECT_URI must match the "Authorized redirect URI"
# registered in Google Cloud Console (APIs & Services > Credentials >
# OAuth 2.0 Client IDs > Authorized redirect URIs).
#
# Local dev:   http://localhost:5000/api/auth/google/callback
# Production:  https://your-backend-domain.com/api/auth/google/callback
#
# CLIENT_URL is where the browser is redirected after a successful Google
# login. Local dev: http://localhost:3000 - Production: https://your-frontend.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
